deployment/final_package_test/
deployment/package/
deployment/v2_package/
deployment/config/

# BioModels inputs are bundled in the release archive, not Git history
deployment/v3_package/inputs/

# Keep only the checksum for the current final release archive
deployment/*.tar.sha256
!deployment/pysr-biomodels-ubuntu24-amd64.tar.sha256

# Historical transfer bundles and machine-specific provenance
phase8a_transfer/
