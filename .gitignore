.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor / OS files
.vscode/
.DS_Store

# Local/manual source backups
*.backup
src/*_frozen.py
src/reporting/*_frozen.py
src/reporting/*_before_*_fix.py

# Release archives (publish final artifacts with GitHub Releases)
*.tar
*.tar.gz

